{
  "name": "next-grafana-embed",
  "version": "1.0.0",
  "private": true,
  "description": "Embed interactive Grafana dashboards in Next.js via a server-side Bearer-token proxy. The service account token never reaches the browser.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test-proxy-logic.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "next-grafana-auth": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.7.0"
  }
}
