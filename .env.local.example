# =============================================================================
# Next.js + Grafana embedded dashboards — environment template
# =============================================================================
# Copy this file to `.env.local` and fill in the real values:
#
#     cp .env.local.example .env.local        # macOS / Linux / Git Bash
#     Copy-Item .env.local.example .env.local # Windows PowerShell
#
# `.env.local` is git-ignored and MUST NEVER be committed.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Note that NONE of the variables below use that prefix — every value here is
# server-side only, which is what keeps the token out of DevTools.
# =============================================================================


# -----------------------------------------------------------------------------
# GRAFANA_URL  (server-side only — REQUIRED)
# -----------------------------------------------------------------------------
# The URL the *Next.js server* uses to reach Grafana. This is never sent to the
# browser; the browser only ever talks to this app's own /api/grafana routes.
#
# RECOMMENDED: give the bare origin, with no path. The proxy appends
# GRAFANA_PATH_PREFIX itself when GRAFANA_STRIP_PATH_PREFIX=false.
GRAFANA_URL=http://13.203.193.234:30016

# Including the sub-path also works — the proxy detects the duplicate and will
# not emit /api/grafana/api/grafana/... — but the bare origin is clearer:
# GRAFANA_URL=http://13.203.193.234:30016/api/grafana

# If Grafana is on the same Docker network as Next.js, prefer the service name:
# GRAFANA_URL=http://grafana:3000
# For local development against a local Grafana:
# GRAFANA_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# GRAFANA_SERVICE_ACCOUNT_TOKEN  (server-side only — REQUIRED)
# -----------------------------------------------------------------------------
# A Grafana *service account token* with the Viewer role. Created in Grafana at:
#     Administration -> Users and access -> Service accounts -> Add service account
#     -> Role: Viewer -> Add service account token -> Copy
#
# SECURITY CONTRACT — do not break any of these:
#   1. Never prefix this with NEXT_PUBLIC_. That would inline it into the
#      client bundle and expose it in DevTools / view-source.
#   2. Never import this in a file that carries "use client".
#   3. Never log it, never echo it in an error response, never put it in a URL.
#   4. Rotate it if it is ever pasted into chat, an issue, or a screenshot.
#
# Tokens look like:  glsa_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX_XXXXXXXX
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_replace_me_with_a_real_viewer_token


# -----------------------------------------------------------------------------
# GRAFANA_ORG_ID  (server-side only — OPTIONAL)
# -----------------------------------------------------------------------------
# Grafana organisation id to scope every proxied request to, sent upstream as
# the `X-Grafana-Org-Id` header. Grafana's default org is 1.
# Leave empty to let Grafana use the service account's default org.
GRAFANA_ORG_ID=1


# -----------------------------------------------------------------------------
# GRAFANA_PATH_PREFIX  (OPTIONAL — default: /api/grafana)
# -----------------------------------------------------------------------------
# The path prefix this app serves the Grafana proxy on. Must stay in sync with
# all three of: the route folder app/api/grafana/[...path], the `baseUrl` passed
# to <GrafanaDashboard>, and Grafana's `root_url` sub-path.
GRAFANA_PATH_PREFIX=/api/grafana


# -----------------------------------------------------------------------------
# GRAFANA_STRIP_PATH_PREFIX  (OPTIONAL — default: false)
# -----------------------------------------------------------------------------
# Controls whether the proxy strips GRAFANA_PATH_PREFIX before calling Grafana.
#
#   false (default) -> Grafana serves from the sub-path itself.
#                      Requires: serve_from_sub_path = true
#                                root_url = http://13.203.193.234:30016/api/grafana/
#                      Target:   GRAFANA_URL + /api/grafana + <path>
#
#   true            -> nginx-style reverse proxy; Grafana serves from root and
#                      the proxy removes the prefix.
#                      Requires: root_url = http://13.203.193.234:30016/api/grafana/
#                                serve_from_sub_path = false
#                      Target:   GRAFANA_URL + <path>
#
# Pick whichever matches your grafana.ini. See README "Sub-path setup".
GRAFANA_STRIP_PATH_PREFIX=false


# -----------------------------------------------------------------------------
# GRAFANA_REQUEST_TIMEOUT_MS  (OPTIONAL — default: 15000)
# -----------------------------------------------------------------------------
# Upstream timeout for API/control-plane requests — everything except datasource
# queries. On expiry the proxy returns 504 rather than hanging.
GRAFANA_REQUEST_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# GRAFANA_QUERY_TIMEOUT_MS  (OPTIONAL — default: 60000)
# -----------------------------------------------------------------------------
# Upstream timeout for datasource queries specifically:
#     POST /api/ds/query          panel + template-variable SQL
#     /api/datasources/proxy/*    direct datasource proxy calls
#
# Kept separate from GRAFANA_REQUEST_TIMEOUT_MS because the two are not
# comparable: 15s for a login ping is already a failure, while a dashboard query
# aggregating over a large table can legitimately run for 30s and still be the
# right answer. Sharing one budget killed those queries and showed a 504 for
# what would have been data.
#
# Note POST is never retried (replaying it could duplicate work upstream), so
# this budget is spent on a single attempt.
GRAFANA_QUERY_TIMEOUT_MS=60000


# -----------------------------------------------------------------------------
# GRAFANA_DEBUG  (OPTIONAL — default: false)
# -----------------------------------------------------------------------------
# When true, the proxy logs method, upstream path, status and duration for each
# request. It NEVER logs the token or the Authorization header.
GRAFANA_DEBUG=false
